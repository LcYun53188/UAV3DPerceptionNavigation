<?xml version="1.0" encoding="UTF-8"?>
<!-- Local validation of the 7.3 MB ESDF reply found stalls with builtin
     transports, while this UDP-only client completed without those stalls.
     Keep this workaround scoped to the map session, not all ROS nodes. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>uav_map_udp</transport_id>
      <type>UDPv4</type>
      <sendBufferSize>1048576</sendBufferSize>
      <receiveBufferSize>8388608</receiveBufferSize>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="uav_map_service" is_default_profile="true">
    <rtps>
      <userTransports><transport_id>uav_map_udp</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
