<?xml version="1.0" encoding="UTF-8"?>
<!-- Explicit owned-session transport experiment. The default ROS transport and
     the scoped map-service profile are unchanged. Select through both
     FASTDDS_DEFAULT_PROFILES_FILE and FASTRTPS_DEFAULT_PROFILES_FILE. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>uav_vio_udp_diagnostic</transport_id>
      <type>UDPv4</type>
      <sendBufferSize>1048576</sendBufferSize>
      <receiveBufferSize>8388608</receiveBufferSize>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="uav_vio_udp_diagnostic" is_default_profile="true">
    <rtps>
      <userTransports><transport_id>uav_vio_udp_diagnostic</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
