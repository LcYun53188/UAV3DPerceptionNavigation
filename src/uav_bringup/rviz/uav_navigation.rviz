Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
- Class: rviz_common/Tool Properties
  Name: Tool Properties
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Enabled: true
    Name: Grid
    Plane Cell Count: 24
  - Class: nvblox_rviz_plugin/NvbloxMesh
    Enabled: true
    Name: 3D nvblox Map
    Mesh Color: Normals
    Cut Ceiling: true
    Ceiling Height: 3.8
    Topic:
      Value: /nvblox_node/mesh
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 5
  - Class: rviz_default_plugins/TF
    Enabled: true
    Name: Drone TF
    Show Names: false
    Marker Scale: 0.5
  - Class: rviz_default_plugins/Path
    Enabled: true
    Name: Planned Path
    Topic:
      Value: /uav/planned_path
  - Class: rviz_default_plugins/Image
    Enabled: true
    Name: RGB Camera
    Topic:
      Value: /rgbd_camera/image
      Reliability Policy: Best Effort
    Transport Hint: raw
  - Class: rviz_default_plugins/Image
    Enabled: true
    Name: Depth Camera
    Topic:
      Value: /rgbd_camera/depth_image
      Reliability Policy: Best Effort
    Transport Hint: raw
  - Class: rviz_default_plugins/Pose
    Name: Navigation Goal (fixed height)
    Enabled: true
    Topic:
      Value: /uav/goal
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Depth: 10
    Shape: Arrow
    Color: 255; 80; 30
    Shaft Length: 0.7
    Shaft Radius: 0.05
    Head Length: 0.25
    Head Radius: 0.12
  Global Options:
    Fixed Frame: map
    Frame Rate: 20
    Background Color: 35; 35; 40
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/SetGoal
    Topic: /uav/rviz/goal_2d
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 32
      Focal Point:
        X: 0
        Y: 0
        Z: 1
      Pitch: 0.8
      Yaw: 0.7
Window Geometry:
  Width: 1250
  Height: 950
  X: 0
  Y: 1100
