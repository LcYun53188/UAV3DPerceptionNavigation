<?xml version="1.0"?>
<sdf version="1.9">
  <world name="uav_obstacle_course">
    <physics name="fast_step" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.42 0.44 0.46 1</ambient>
      <background>0.66 0.71 0.76 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <pose>0 0 12 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.95 0.95 0.92 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.35 0.25 -0.9</direction>
    </light>

    <!-- Large flat ground plane. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>26 26</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>20</mu>
                <mu2>20</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>26 26</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.50 0.52 0.54 1</ambient>
            <diffuse>0.52 0.54 0.56 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Surrounding perimeter walls. The central route stays inside. -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 10 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20.4 0.20 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>20.4 0.20 1.5</size></box></geometry><material><ambient>0.48 0.28 0.52 1</ambient><diffuse>0.66 0.34 0.74 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -10 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20.4 0.20 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>20.4 0.20 1.5</size></box></geometry><material><ambient>0.22 0.42 0.55 1</ambient><diffuse>0.22 0.56 0.72 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>10 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.20 20.4 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.20 20.4 1.5</size></box></geometry><material><ambient>0.48 0.28 0.52 1</ambient><diffuse>0.66 0.34 0.74 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-10 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.20 20.4 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.20 20.4 1.5</size></box></geometry><material><ambient>0.45 0.36 0.16 1</ambient><diffuse>0.60 0.47 0.20 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Columns on both sides of the south-to-north route. -->
    <model name="column_00">
      <static>true</static>
      <pose>-4 -5 1.0 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><cylinder><radius>0.14</radius><length>2.0</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.14</radius><length>2.0</length></cylinder></geometry><material><ambient>0.26 0.44 0.52 1</ambient><diffuse>0.30 0.60 0.72 1</diffuse></material></visual></link>
    </model>
    <model name="column_01">
      <static>true</static>
      <pose>4 -5 1.0 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><cylinder><radius>0.14</radius><length>2.0</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.14</radius><length>2.0</length></cylinder></geometry><material><ambient>0.44 0.34 0.20 1</ambient><diffuse>0.68 0.52 0.28 1</diffuse></material></visual></link>
    </model>
    <model name="column_02">
      <static>true</static>
      <pose>-5 -2 1.0 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><cylinder><radius>0.14</radius><length>2.0</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.14</radius><length>2.0</length></cylinder></geometry><material><ambient>0.50 0.24 0.46 1</ambient><diffuse>0.74 0.34 0.66 1</diffuse></material></visual></link>
    </model>
    <model name="column_03">
      <static>true</static>
      <pose>5 -2 1.0 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><cylinder><radius>0.14</radius><length>2.0</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.14</radius><length>2.0</length></cylinder></geometry><material><ambient>0.28 0.30 0.62 1</ambient><diffuse>0.42 0.44 0.82 1</diffuse></material></visual></link>
    </model>
    <model name="column_04">
      <static>true</static>
      <pose>-3 0 1.0 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><cylinder><radius>0.14</radius><length>2.0</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.14</radius><length>2.0</length></cylinder></geometry><material><ambient>0.36 0.52 0.20 1</ambient><diffuse>0.54 0.72 0.34 1</diffuse></material></visual></link>
    </model>
    <model name="column_05">
      <static>true</static>
      <pose>3 1 1.0 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><cylinder><radius>0.14</radius><length>2.0</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.14</radius><length>2.0</length></cylinder></geometry><material><ambient>0.22 0.48 0.56 1</ambient><diffuse>0.30 0.66 0.78 1</diffuse></material></visual></link>
    </model>
    <model name="column_06">
      <static>true</static>
      <pose>-4 4 1.0 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><cylinder><radius>0.14</radius><length>2.0</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.14</radius><length>2.0</length></cylinder></geometry><material><ambient>0.50 0.40 0.16 1</ambient><diffuse>0.70 0.58 0.24 1</diffuse></material></visual></link>
    </model>
    <model name="column_07">
      <static>true</static>
      <pose>4 4 1.0 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><cylinder><radius>0.14</radius><length>2.0</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.14</radius><length>2.0</length></cylinder></geometry><material><ambient>0.42 0.22 0.56 1</ambient><diffuse>0.62 0.30 0.76 1</diffuse></material></visual></link>
    </model>
    <model name="column_08">
      <static>true</static>
      <pose>-7 0 1.0 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><cylinder><radius>0.14</radius><length>2.0</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.14</radius><length>2.0</length></cylinder></geometry><material><ambient>0.26 0.44 0.52 1</ambient><diffuse>0.30 0.60 0.72 1</diffuse></material></visual></link>
    </model>
    <model name="column_09">
      <static>true</static>
      <pose>7 0 1.0 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><cylinder><radius>0.14</radius><length>2.0</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.14</radius><length>2.0</length></cylinder></geometry><material><ambient>0.44 0.34 0.20 1</ambient><diffuse>0.68 0.52 0.28 1</diffuse></material></visual></link>
    </model>

    <!-- Initial model placement for sensor and scene validation. -->
    <model name="gate_south">
      <static>true</static>
      <pose>0 -3 0 0 0 0</pose>
      <link name="link">
        <collision name="left_post_collision"><pose>-1.1 0 0.9 0 0 0</pose><geometry><box><size>0.18 0.18 1.8</size></box></geometry></collision>
        <visual name="left_post_visual"><pose>-1.1 0 0.9 0 0 0</pose><geometry><box><size>0.18 0.18 1.8</size></box></geometry><material><ambient>0.20 0.45 0.50 1</ambient><diffuse>0.25 0.65 0.72 1</diffuse></material></visual>
        <collision name="right_post_collision"><pose>1.1 0 0.9 0 0 0</pose><geometry><box><size>0.18 0.18 1.8</size></box></geometry></collision>
        <visual name="right_post_visual"><pose>1.1 0 0.9 0 0 0</pose><geometry><box><size>0.18 0.18 1.8</size></box></geometry><material><ambient>0.20 0.45 0.50 1</ambient><diffuse>0.25 0.65 0.72 1</diffuse></material></visual>
        <collision name="bottom_rail_collision"><pose>0 0 0.6 0 0 0</pose><geometry><box><size>2.38 0.18 0.18</size></box></geometry></collision>
        <visual name="bottom_rail_visual"><pose>0 0 0.6 0 0 0</pose><geometry><box><size>2.38 0.18 0.18</size></box></geometry><material><ambient>0.20 0.45 0.50 1</ambient><diffuse>0.25 0.65 0.72 1</diffuse></material></visual>
        <collision name="top_rail_collision"><pose>0 0 1.8 0 0 0</pose><geometry><box><size>2.38 0.18 0.18</size></box></geometry></collision>
        <visual name="top_rail_visual"><pose>0 0 1.8 0 0 0</pose><geometry><box><size>2.38 0.18 0.18</size></box></geometry><material><ambient>0.20 0.45 0.50 1</ambient><diffuse>0.25 0.65 0.72 1</diffuse></material></visual>
      </link>
    </model>

    <model name="gate_middle">
      <static>true</static>
      <pose>0 0.5 0 0 0 1.57079632679</pose>
      <link name="link">
        <collision name="left_post_collision"><pose>-1.1 0 0.9 0 0 0</pose><geometry><box><size>0.18 0.18 1.8</size></box></geometry></collision>
        <visual name="left_post_visual"><pose>-1.1 0 0.9 0 0 0</pose><geometry><box><size>0.18 0.18 1.8</size></box></geometry><material><ambient>0.55 0.28 0.12 1</ambient><diffuse>0.80 0.42 0.18 1</diffuse></material></visual>
        <collision name="right_post_collision"><pose>1.1 0 0.9 0 0 0</pose><geometry><box><size>0.18 0.18 1.8</size></box></geometry></collision>
        <visual name="right_post_visual"><pose>1.1 0 0.9 0 0 0</pose><geometry><box><size>0.18 0.18 1.8</size></box></geometry><material><ambient>0.55 0.28 0.12 1</ambient><diffuse>0.80 0.42 0.18 1</diffuse></material></visual>
        <collision name="bottom_rail_collision"><pose>0 0 0.6 0 0 0</pose><geometry><box><size>2.38 0.18 0.18</size></box></geometry></collision>
        <visual name="bottom_rail_visual"><pose>0 0 0.6 0 0 0</pose><geometry><box><size>2.38 0.18 0.18</size></box></geometry><material><ambient>0.55 0.28 0.12 1</ambient><diffuse>0.80 0.42 0.18 1</diffuse></material></visual>
        <collision name="top_rail_collision"><pose>0 0 1.8 0 0 0</pose><geometry><box><size>2.38 0.18 0.18</size></box></geometry></collision>
        <visual name="top_rail_visual"><pose>0 0 1.8 0 0 0</pose><geometry><box><size>2.38 0.18 0.18</size></box></geometry><material><ambient>0.55 0.28 0.12 1</ambient><diffuse>0.80 0.42 0.18 1</diffuse></material></visual>
      </link>
    </model>

    <model name="gate_north">
      <static>true</static>
      <pose>0 4 0 0 0 0</pose>
      <link name="link">
        <collision name="left_post_collision"><pose>-1.1 0 0.9 0 0 0</pose><geometry><box><size>0.18 0.18 1.8</size></box></geometry></collision>
        <visual name="left_post_visual"><pose>-1.1 0 0.9 0 0 0</pose><geometry><box><size>0.18 0.18 1.8</size></box></geometry><material><ambient>0.50 0.25 0.50 1</ambient><diffuse>0.74 0.36 0.74 1</diffuse></material></visual>
        <collision name="right_post_collision"><pose>1.1 0 0.9 0 0 0</pose><geometry><box><size>0.18 0.18 1.8</size></box></geometry></collision>
        <visual name="right_post_visual"><pose>1.1 0 0.9 0 0 0</pose><geometry><box><size>0.18 0.18 1.8</size></box></geometry><material><ambient>0.50 0.25 0.50 1</ambient><diffuse>0.74 0.36 0.74 1</diffuse></material></visual>
        <collision name="bottom_rail_collision"><pose>0 0 0.6 0 0 0</pose><geometry><box><size>2.38 0.18 0.18</size></box></geometry></collision>
        <visual name="bottom_rail_visual"><pose>0 0 0.6 0 0 0</pose><geometry><box><size>2.38 0.18 0.18</size></box></geometry><material><ambient>0.50 0.25 0.50 1</ambient><diffuse>0.74 0.36 0.74 1</diffuse></material></visual>
        <collision name="top_rail_collision"><pose>0 0 1.8 0 0 0</pose><geometry><box><size>2.38 0.18 0.18</size></box></geometry></collision>
        <visual name="top_rail_visual"><pose>0 0 1.8 0 0 0</pose><geometry><box><size>2.38 0.18 0.18</size></box></geometry><material><ambient>0.50 0.25 0.50 1</ambient><diffuse>0.74 0.36 0.74 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Large object-stacking platform on the east side. -->
    <model name="object_platform">
      <static>true</static>
      <pose>6 1 0.025 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>5.5 3.5 0.05</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5.5 3.5 0.05</size></box></geometry><material><ambient>0.30 0.30 0.32 1</ambient><diffuse>0.40 0.40 0.42 1</diffuse></material></visual>
      </link>
    </model>

    <model name="object_crate_large">
      <static>true</static>
      <pose>4.2 0.5 0.45 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.8 0.8 0.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.8 0.8 0.8</size></box></geometry><material><ambient>0.56 0.36 0.14 1</ambient><diffuse>0.80 0.54 0.20 1</diffuse></material></visual></link>
    </model>
    <model name="object_crate_medium">
      <static>true</static>
      <pose>5.8 1.8 0.35 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.6 0.6 0.6</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.6 0.6 0.6</size></box></geometry><material><ambient>0.24 0.42 0.48 1</ambient><diffuse>0.34 0.60 0.70 1</diffuse></material></visual></link>
    </model>
    <model name="object_crate_small">
      <static>true</static>
      <pose>7.4 0.6 0.25 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.5 0.5 0.5</size></box></geometry><material><ambient>0.55 0.20 0.22 1</ambient><diffuse>0.82 0.30 0.34 1</diffuse></material></visual></link>
    </model>
    <model name="object_barrel_1">
      <static>true</static>
      <pose>6.5 0.1 0.4 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><cylinder><radius>0.28</radius><length>0.8</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.28</radius><length>0.8</length></cylinder></geometry><material><ambient>0.25 0.25 0.30 1</ambient><diffuse>0.32 0.32 0.40 1</diffuse></material></visual></link>
    </model>
    <model name="object_barrel_2">
      <static>true</static>
      <pose>6.0 2.4 0.4 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><cylinder><radius>0.28</radius><length>0.8</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.28</radius><length>0.8</length></cylinder></geometry><material><ambient>0.25 0.25 0.30 1</ambient><diffuse>0.32 0.32 0.40 1</diffuse></material></visual></link>
    </model>
    <model name="object_stack_base">
      <static>true</static>
      <pose>5.2 1.2 0.35 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.6 0.6 0.6</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.6 0.6 0.6</size></box></geometry><material><ambient>0.42 0.52 0.20 1</ambient><diffuse>0.62 0.74 0.30 1</diffuse></material></visual></link>
    </model>
    <model name="object_stack_top">
      <static>true</static>
      <pose>5.2 1.2 0.75 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.4 0.4 0.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.4 0.4 0.4</size></box></geometry><material><ambient>0.42 0.52 0.20 1</ambient><diffuse>0.62 0.74 0.30 1</diffuse></material></visual></link>
    </model>

    <!-- Start and goal pads. -->
    <model name="start_pad">
      <static>true</static>
      <pose>0 -7 0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.4 1.4 0.02</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.4 1.4 0.02</size></box></geometry><material><ambient>0.10 0.55 0.15 1</ambient><diffuse>0.15 0.78 0.22 1</diffuse></material></visual>
      </link>
    </model>
    <model name="goal_pad">
      <static>true</static>
      <pose>0 7 0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.4 1.4 0.02</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.4 1.4 0.02</size></box></geometry><material><ambient>0.65 0.10 0.08 1</ambient><diffuse>0.90 0.16 0.12 1</diffuse></material></visual>
      </link>
    </model>

    <!-- UAV starts on the green pad, facing north along the central corridor. -->
    <include>
      <uri>model://uav_quad_mid360</uri>
      <name>uav_quad</name>
      <pose>0 -7 0.11 0 0 1.57079632679</pose>
    </include>
  </world>
</sdf>
