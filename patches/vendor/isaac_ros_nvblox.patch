+template<typename MessageType>
+void NvbloxBaseVisual<MessageType>::update()
+{
+  if (!params_->paramsChanged()) {return;}
+  if constexpr (std::is_same_v<MessageType, nvblox_msgs::msg::Mesh>) {
+    // Recolor the whole retained map, even when the publisher is idle or sends only deltas.
+    auto msg = std::make_shared<nvblox_msgs::msg::Mesh>();
+    msg->block_size_m = block_size_m_;
+    for (const auto & entry : mesh_blocks_) {
+      msg->block_indices.push_back(entry.first);
+      msg->blocks.push_back(entry.second);
+    }
+    setMessage(msg);
+  }
+  maybeCutCeiling(params_->getCutCeiling(), params_->getCeilingHeight());
+}
