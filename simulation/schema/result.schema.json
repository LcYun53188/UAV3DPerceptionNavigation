{
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "profile": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE",
        "N/A"
      ]
    },
    "started_at": {
      "type": "string"
    },
    "duration_monotonic_s": {
      "type": "number",
      "minimum": 0
    },
    "config_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "test_id": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "INCONCLUSIVE",
              "N/A"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "required": [
          "test_id",
          "required",
          "status",
          "reason",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "run_id",
    "profile",
    "scope",
    "status",
    "started_at",
    "duration_monotonic_s",
    "config_hash",
    "tests"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
