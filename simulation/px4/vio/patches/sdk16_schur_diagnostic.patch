   Matrix15T invHb = svd.matrixV() * singularValues_inv.asDiagonal() * svd.matrixU().transpose();
 
   Matrix15T res = Hn.block<15, 15>(0, 0) - Hn.block<15, 15>(0, 15) * invHb * Hn.block<15, 15>(15, 0);
+  // Passive diagnostic only: retain the original float result and optimizer.
+  if (const char* path = std::getenv("CUVSLAM_SCHUR_DIAGNOSTIC")) {
+    const Eigen::Matrix<double,15,15> pose_info = res.cast<double>();
+    Eigen::LDLT<Eigen::Matrix<double,15,15>> check((pose_info+pose_info.transpose())*.5);
+    if (!pose_info.allFinite() || check.info()!=Eigen::Success ||
+        (check.vectorD().array()<=0.).any()) {
+      using M15d = Eigen::Matrix<double,15,15>;
+      const M15d previous = H.topLeftCorner<15,15>().cast<double>();
+      Eigen::JacobiSVD<M15d> reference(previous, Eigen::ComputeFullU | Eigen::ComputeFullV);
+      auto inverse_values = reference.singularValues().eval();
+      for (int i=0;i<15;++i) inverse_values(i)=inverse_values(i)>1e-6 ? 1./inverse_values(i) : 0.;
+      const M15d inverse = reference.matrixV()*inverse_values.asDiagonal()*reference.matrixU().transpose();
+      const M15d reference_schur = H.bottomRightCorner<15,15>().cast<double>() -
+          H.bottomLeftCorner<15,15>().cast<double>()*inverse*H.topRightCorner<15,15>().cast<double>();
+      static std::ofstream diagnostic(path);
+      static unsigned long count=0;
+      diagnostic << std::setprecision(17) << ++count;
+      for (int i=0;i<30;++i) for (int j=0;j<30;++j) diagnostic << ',' << H(i,j);
+      for (int i=0;i<15;++i) for (int j=0;j<15;++j) diagnostic << ',' << res(i,j);
+      for (int i=0;i<15;++i) for (int j=0;j<15;++j) diagnostic << ',' << reference_schur(i,j);
+      diagnostic << '\n';
+    }
+  }
   return res;
 }
 
